{
	"extends": "@crosmos/typescript-config/nextjs.json",
	"compilerOptions": {
		"baseUrl": ".",
		"paths": {
			"@/*": ["./*"],
			"@crosmos/ui/*": ["../../packages/ui/src/*"],
			"@crosmos/graph": ["../../packages/graph/src/index.ts"],
			"@crosmos/graph/adapters/crosmos": [
				"../../packages/graph/src/adapters/crosmos/index.ts"
			],
			"@crosmos/graph/mock": ["../../packages/graph/src/mock/index.ts"],
			"@crosmos/graph/styles.css": [
				"../../packages/graph/src/public/styles.css"
			],
			"@crosmos/graph/*": ["../../packages/graph/src/*"]
		},
		"plugins": [
			{
				"name": "next"
			}
		]
	},
	"include": [
		"next-env.d.ts",
		"next.config.ts",
		"**/*.ts",
		"**/*.tsx",
		".next/types/**/*.ts"
	],
	"exclude": ["node_modules"]
}
