{
	"$schema": "https://ui.shadcn.com/schema.json",
	"style": "radix-nova",
	"rsc": true,
	"tsx": true,
	"tailwind": {
		"config": "",
		"css": "../../packages/ui/src/styles/globals.css",
		"baseColor": "neutral",
		"cssVariables": true
	},
	"iconLibrary": "tabler",
	"rtl": false,
	"menuColor": "default-translucent",
	"menuAccent": "subtle",
	"aliases": {
