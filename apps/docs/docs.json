{
	"$schema": "https://mintlify.com/docs.json",
	"theme": "maple",
	"name": "Crosmos",
	"colors": {
		"primary": "#298559",
		"light": "#298559",
		"dark": "#298559"
	},
	"favicon": "/favicon.svg",
	"navigation": {
		"tabs": [
			{
				"tab": "Guides",
				"icon": "compass",
				"groups": [
					{
						"group": "Getting Started",
						"pages": ["index", "quickstart"]
					},
					{
						"group": "Concepts",
						"pages": [
							"how-it-works",
							"memories",
							"mtkg",
							"forgetting",
							"recall",
							"clusters"
						]
					},
					{
						"group": "Plugins",
						"pages": ["plugins/mcp"]
					}
				]
			},
			{
				"tab": "Toolkit",
				"icon": "wrench",
				"groups": [
					{
						"group": "Graph",
						"pages": [
							"toolkit/graph/quickstart",
							"toolkit/graph/reference",
							"toolkit/graph/theme"
						]
					}
				]
			},
			{
				"tab": "API Reference",
				"icon": "code",
				"openapi": "https://api.crosmos.dev/openapi.json"
			}
		],
		"global": {
			"anchors": [
				{
					"anchor": "Console",
					"href": "https://console.crosmos.dev",
					"icon": "window-maximize"
				}
			]
		}
	},
	"logo": {
		"light": "/logo/banner_light.svg",
		"dark": "/logo/banner_dark.svg",
		"href": "https://crosmos.dev"
	},
	"navbar": {
		"links": [
			{
				"label": "Support",
				"href": "mailto:hello@crosmos.dev"
			}
		],
		"primary": {
			"type": "button",
			"label": "Dashboard",
			"href": "https://crosmos.dev"
		}
	},
	"footer": {
		"socials": {
			"x": "https://x.com/crosmoslabs",
			"github": "https://github.com/crosmos-labs",
			"linkedin": "https://linkedin.com/company/crosmos-ai"
		}
	},
	"fonts": {
		"heading": {
			"family": "Satoshi",
			"source": "/fonts/Satoshi.woff2",
			"format": "woff2",
			"weight": 700
		},
		"body": {
			"family": "Rubik",
			"weight": 400
		}
	},
	"appearance": {
		"strict": false,
		"default": "system"
	},
	"seo": {
		"metatags": {
			"charset": "UTF-8",
			"viewport": "width=device-width, initial-scale=1",
			"robots": "index, follow",

			"application-name": "Crosmos Documentation",
			"color-scheme": "light dark",

			"description": "Crosmos documentation for memory layer, API, SDKs, MCPs and other tools.",

			"og:title": "Crosmos Documentation",
			"og:type": "website",
			"og:url": "https://docs.crosmos.dev",
			"og:description": "Build apps with our Memory API which supports most modern toolkits",
			"og:site_name": "Crosmos Docs",
			"og:locale": "en_US"
		},
		"indexing": "all"
	},
	"background": {
		"color": {
			"light": "#ffffff",
			"dark": "#1a1a1a"
		}
	},
	"errors": {
		"404": {
			"redirect": false,
			"title": "Page Not Found, Coffee Not Included",
			"description": "This isn’t where you meant to go. Or maybe it is—either way, nothing’s here."
		}
	},
	"api": {
		"openapi": "https://api.crosmos.dev/openapi.json"
	}
}
