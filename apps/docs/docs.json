{
	"$schema": "https://mintlify.com/docs.json",
	"theme": "maple",
	"name": "Documentation",
	"colors": {
		"primary": "#298559",
		"light": "#298559",
		"dark": "#298559"
	},
	"favicon": "/favicon.svg",
	"navigation": {
		"tabs": [
			{
				"tab": "Guides",
				"icon": "compass",
				"groups": [
					{
						"group": "Getting Started",
						"pages": ["index", "quickstart"]
					},
					{
						"group": "Concepts",
						"pages": [
							"how-it-works",
							"memories",
							"mtkg",
							"forgetting",
							"recall",
							"clusters"
						]
					},
					{
						"group": "MCP",
						"pages": [
							"mcp/overview",
							"mcp/tools",
							"mcp/configuration",
							"mcp/skills"
						]
					},
					{
						"group": "SDKs",
						"pages": ["sdks", "sdks/advanced"]
					}
				]
			},
			{
				"tab": "Plugins",
				"icon": "puzzle-piece",
				"groups": [
					{
						"group": "Agent Plugins",
						"pages": [
							"plugins/claude-code",
							"plugins/codex",
							"plugins/opencode"
						]
					}
				]
			},
			{
				"tab": "Toolkit",
				"icon": "wrench",
				"groups": [
					{
						"group": "Graph",
						"pages": [
							"toolkit/graph/quickstart",
							"toolkit/graph/reference",
							"toolkit/graph/theme"
						]
					}
				]
			},
			{
				"tab": "API Reference",
				"icon": "code",
				"openapi": "https://api.crosmos.dev/openapi.json"
			}
		],
		"global": {
			"anchors": [
				{
					"anchor": "Console",
					"href": "https://console.crosmos.dev",
					"icon": "window-maximize"
				}
			]
		}
	},
	"logo": {
		"light": "/logo/banner_light.svg",
		"dark": "/logo/banner_dark.svg",
		"href": "https://crosmos.dev"
	},
	"navbar": {
		"links": [
			{
				"label": "Support",
				"href": "mailto:hello@crosmos.dev"
			}
		],
		"primary": {
			"type": "button",
			"label": "Dashboard",
			"href": "https://crosmos.dev"
		}
	},
	"footer": {
		"socials": {
			"x": "https://x.com/crosmoslabs",
			"github": "https://github.com/crosmos-labs",
			"linkedin": "https://linkedin.com/company/crosmos-ai"
		}
	},
	"fonts": {
		"heading": {
			"family": "Satoshi",
			"source": "/fonts/Satoshi.woff2",
			"format": "woff2",
			"weight": 700
		},
		"body": {
			"family": "Rubik",
			"weight": 400
		}
	},
	"appearance": {
		"strict": false,
		"default": "system"
	},
	"seo": {
		"metatags": {
			"charset": "UTF-8",
			"viewport": "width=device-width, initial-scale=1",
			"robots": "index, follow",

			"application-name": "Documentation",
			"color-scheme": "light dark",

			"description": "Crosmos documentation for memory, SDKs, MCP, API reference, and graph tooling.",

			"og:title": "Documentation",
			"og:type": "website",
			"og:url": "https://docs.crosmos.dev",
			"og:description": "Crosmos documentation for memory, SDKs, MCP, API reference, and graph tooling.",
			"og:site_name": "Documentation",
			"og:locale": "en_US"
		},
		"indexing": "all"
	},
	"background": {
		"color": {
			"light": "#ffffff",
			"dark": "#1a1a1a"
		}
	},
	"errors": {
		"404": {
			"redirect": false,
			"title": "Page Not Found, Coffee Not Included",
			"description": "This isn’t where you meant to go. Or maybe it is—either way, nothing’s here."
		}
	},
	"api": {
		"openapi": "https://api.crosmos.dev/openapi.json"
	},
	"redirects": [
		{
			"source": "/plugins/mcp",
			"destination": "/mcp/overview"
		},
		{
			"source": "/mcp",
			"destination": "/mcp/overview"
		},
		{
			"source": "/mcp/setup",
			"destination": "/mcp/overview"
		},
		{
			"source": "/integrations/mcp",
			"destination": "/mcp/overview"
		},
		{
			"source": "/integrations/codex",
			"destination": "/plugins/codex"
		},
		{
			"source": "/integrations/typescript-sdk",
			"destination": "/sdks"
		},
		{
			"source": "/integrations/typescript-sdk/advanced",
			"destination": "/sdks/advanced"
		}
	]
}
