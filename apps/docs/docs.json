{
	"$schema": "https://mintlify.com/docs.json",
	"theme": "maple",
	"name": "Crosmos - Documentation",
	"colors": {
		"primary": "#298559",
		"light": "#298559",
		"dark": "#298559"
	},
	"favicon": "/favicon.svg",
	"navigation": {
		"tabs": [
			{
				"tab": "Guides",
				"groups": [
					{
						"group": "Getting started",
						"pages": ["index", "quickstart", "development"]
					},
					{
						"group": "Customization",
						"pages": ["essentials/settings", "essentials/navigation"]
					},
					{
						"group": "Writing content",
						"pages": [
							"essentials/markdown",
							"essentials/code",
							"essentials/images",
							"essentials/reusable-snippets"
						]
					},
					{
						"group": "AI tools",
						"pages": [
							"ai-tools/cursor",
							"ai-tools/claude-code",
							"ai-tools/windsurf"
						]
					}
				]
			},
			{
				"tab": "API reference",
				"groups": [
					{
						"group": "API documentation",
						"pages": ["api-reference/introduction"]
					},
					{
						"group": "Endpoint examples",
						"pages": [
							"api-reference/endpoint/get",
							"api-reference/endpoint/create",
							"api-reference/endpoint/delete",
							"api-reference/endpoint/webhook"
						]
					}
				]
			}
		],
		"global": {
			"anchors": [
				{
					"anchor": "Documentation",
					"href": "https://docs.crosmos.app",
					"icon": "book-open-cover"
				},
				{
					"anchor": "Blog",
					"href": "https://crosmos.app/blogs",
					"icon": "newspaper"
				}
			]
		}
	},
	"logo": {
		"light": "/logo/banner_light.svg",
		"dark": "/logo/banner_dark.svg",
		"href": "https://crosmos.dev"
	},
	"navbar": {
		"links": [
			{
				"label": "Support",
				"href": "mailto:hello@crosmos.dev"
			}
		],
		"primary": {
			"type": "button",
			"label": "Dashboard",
			"href": "https://crosmos.app"
		}
	},
	"contextual": {
		"options": [
			"copy",
			"view",
			"chatgpt",
			"claude",
			"perplexity",
			"mcp",
			"cursor",
			"vscode"
		]
	},
	"footer": {
		"socials": {
			"x": "https://x.com/crosmoslabs",
			"github": "https://github.com/crosmos-app",
			"linkedin": "https://linkedin.com/company/crosmos-ai"
		}
	},
	"fonts": {
		"heading": {
			"family": "Satoshi",
			"source": "/fonts/Satoshi.woff2",
			"format": "woff2",
			"weight": 700
		},
		"body": {
			"family": "Rubik",
			"weight": 400
		}
	},
	"appearance": {
		"strict": false,
		"default": "system"
	},
	"seo": {
		"metatags": {
			"charset": "UTF-8",
			"viewport": "width=device-width, initial-scale=1",
			"robots": "index, follow",

			"application-name": "Crosmos Documentation",
			"color-scheme": "light dark",

			"description": "Crosmos documentation for memory engine, API, SDKs, MCPs and other tools.",

			"og:title": "Crosmos Docs - Memory Engine",
			"og:type": "website",
			"og:url": "https://docs.crosmos.dev",
			"og:description": "Build apps with our Memory API which supports most modern toolkits",
			"og:site_name": "Crosmos Docs",
			"og:locale": "en_US"
		},
		"indexing": "all"
	},
	"background": {
		"color": {
			"light": "#ffffff",
			"dark": "#1a1a1a"
		}
	},
	"errors": {
		"404": {
			"redirect": false,
			"title": "Page Not Found, Coffee Not Included",
			"description": "This isn’t where you meant to go. Or maybe it is—either way, nothing’s here."
		}
	}
}
