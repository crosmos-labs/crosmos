{
	"$schema": "https://mintlify.com/docs.json",
	"theme": "maple",
	"name": "Crosmos",
	"colors": {
		"primary": "#298559",
		"light": "#298559",
		"dark": "#298559"
	},
	"favicon": "/favicon.svg",
	"navigation": {
		"tabs": [
			{
				"tab": "Guides",
				"icon": "compass",
				"groups": [
					{
						"group": "Getting Started",
						"pages": ["index", "quickstart"]
					},
					{
						"group": "Concepts",
						"pages": ["memories", "mtkg", "clusters"]
					},
					{
						"group": "Plugins",
						"pages": ["mcp"]
					}
				]
			},
			{
				"tab": "API Reference",
				"icon": "code",
				"openapi": "https://api.crosmos.dev/openapi.json"
			}
		],
		"global": {
			"anchors": [
				{
					"anchor": "Console",
					"href": "https://console.crosmos.dev",
					"icon": "window-maximize"
				}
			]
		}
	},
	"logo": {
		"light": "/logo/banner_light.svg",
		"dark": "/logo/banner_dark.svg",
		"href": "https://crosmos.dev"
	},
	"navbar": {
		"links": [
			{
				"label": "Support",
				"href": "mailto:hello@crosmos.dev"
			}
		],
		"primary": {
			"type": "button",
			"label": "Dashboard",
			"href": "https://crosmos.dev"
		}
	},
	"footer": {
		"socials": {
			"x": "https://x.com/crosmoslabs",
			"github": "https://github.com/crosmos-app",
			"linkedin": "https://linkedin.com/company/crosmos-ai"
		}
	},
	"fonts": {
		"heading": {
			"family": "Satoshi",
			"source": "/fonts/Satoshi.woff2",
			"format": "woff2",
			"weight": 700
		},
		"body": {
			"family": "Rubik",
			"weight": 400
		}
	},
	"appearance": {
		"strict": false,
		"default": "system"
	},
	"api": {
		"openapi": "https://api.crosmos.dev/openapi.json"
	}
}
