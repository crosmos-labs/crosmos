{
	"$schema": "https://turborepo.dev/schema.json",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": [".next/**", "!.next/cache/**"],
			"env": ["ANTHROPIC_API_KEY"]
		},

		"dev": {
			"cache": false,
			"persistent": true
		},

		"typecheck": {
			"dependsOn": ["^typecheck"],
			"outputs": []
		},

		"test": {
			"dependsOn": ["^build"],
			"outputs": ["coverage/**"]
		},

		"clean": {
			"cache": false
		}
	}
}
